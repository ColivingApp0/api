# Local overrides for the ColivinApp backend (development profile).
# Copy this file to `api/.env` and fill the values. `.env` is ignored by git.
#
# The `dev` profile defaults to the logging mail transport and no push:
# the application starts without any of these values.

# Public frontend origin used in e-mail/push links.
APP_PUBLIC_BASE_URL=http://localhost:8080

# ---------- E-mail ----------
# log | smtp | mailtrap | firebase
MAIL_PROVIDER=mailtrap
# Use an address on a domain verified in Mailtrap → Sending Domains.
MAIL_FROM=no-reply@your-verified-domain.com
MAIL_FROM_NAME=ColivinApp
# Send a generic e-mail to the recipient of every new message.
MAIL_MESSAGE_NOTIFICATIONS=true

# Mailtrap Email Sending API token (Sending Domains → API tokens).
MAILTRAP_TOKEN=
# Email Testing sandbox instead of the Sending API:
MAILTRAP_SANDBOX=false
MAILTRAP_INBOX_ID=

# Alternative: Google Workspace / Gmail SMTP (app password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- Push (FCM) ----------
PUSH_ENABLED=false
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=coolivinapp
# Absolute path to the service-account JSON (never commit it).
FIREBASE_CREDENTIALS=
